{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "description": "AEGIS: Adaptive Environment for Gesture Interaction & Spatial Intelligence",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "setup:model": "node scripts/setup-model.mjs",
    "test": "vitest run --project unit",
    "e2e": "vite build --mode e2e && playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "onnxruntime-web": "1.30.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
